# ==============================================================================
# Volker Schnüttgen Portfolio — Environment Variables
# Copy to .env locally if needed. In Vercel, configure per phase in Project Settings.
# ==============================================================================

# [PHASE 1 / PHASE 5] Canonical site URL used for SEO (canonical, sitemap.xml, robots.txt, llms.txt)
# In Vercel Phase 1 you can omit it (auto-detected from host) or set your *.vercel.app URL.
# In Phase 5 (custom domain), set: https://volker-schnuettgen.com
APP_URL="https://volker-schnuettgen.com"

# Runtime environment ("development" locally, "production" on Vercel automatically)
NODE_ENV="development"

# [PHASE 2] Turso (LibSQL / SQLite Cloud) — SERVER ONLY (SECRET)
# Without TURSO_DATABASE_URL on Vercel, the site runs in read-only seed mode.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# [PHASE 3] Cloudinary Signed Direct Uploads — SERVER ONLY (API_SECRET is STRICTLY SECRET)
# Without these variables, the admin upload endpoint returns 503.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# [PHASE 4] Studio Admin Authentication — SERVER ONLY (SECRET)
# SESSION_SECRET: Required in production/Vercel to sign Admin Bearer tokens (min 32 random chars).
# If missing in production, only /admin login is disabled while the public site works normally.
SESSION_SECRET=""

# ADMIN_PASSCODE: Admin console password in production.
# Whenever set (and always in production), first-run browser password setup (/api/admin/auth/setup) is disabled.
ADMIN_PASSCODE=""
